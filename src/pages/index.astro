---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Aura & Scape - Events, Decor, Experiences"
  description="Aura & Scape — Where creativity meets elegance. Events, Decor, Experiences by Antima & Shilpa. Edinburgh, Scotland."
>
  <!-- Hero -->
  <section class="hero" aria-label="Hero">
    <div class="hero-content">
      <h1>Where Memories Become Magic</h1>
      <p class="hero-subtitle">DREAM &bull; DECORATE &bull; CELEBRATE</p>
      <div class="hero-buttons">
        <a href="/contact" class="btn-primary">Book a Consultation</a>
        <a href="/portfolio" class="btn-secondary">View Portfolio</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--cream" aria-label="Services">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Our Services</h2>
        <span class="section-line"></span>
      </div>

      <div class="services-grid reveal-stagger">
        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 48V22C10 12 18 6 28 6s18 6 18 16v26"/>
              <path d="M17 48V24c0-6 3-10 11-10s11 4 11 10v24"/>
              <line x1="8" y1="48" x2="48" y2="48"/>
            </svg>
          </div>
          <h3>Events</h3>
          <p>From intimate gatherings to grand celebrations, we craft unforgettable moments with elegance and precision.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="10" y="8" width="36" height="40" rx="1"/>
              <path d="M10 8h36"/>
              <path d="M20 8v40"/>
              <path d="M36 8v40"/>
              <path d="M20 28c3-3 5-4 8-4s5 1 8 4"/>
            </svg>
          </div>
          <h3>Decor</h3>
          <p>Dreamy backdrops, statement florals, and curated styling that brings your vision to life in every detail.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 10v4"/><path d="M14 14c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="14" y1="30" x2="14" y2="46"/>
              <path d="M28 8v4"/><path d="M28 12c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="28" y1="28" x2="28" y2="46"/>
              <path d="M42 10v4"/><path d="M42 14c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="42" y1="30" x2="42" y2="46"/>
            </svg>
          </div>
          <h3>Experiences</h3>
          <p>Curated sensory moments — live music, fragrance stations, and interactive displays that make guests feel special.</p>
        </div>
      </div>

      <div class="text-center" style="margin-top: 40px;">
        <a href="/services" class="btn-outline">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="section section--rose" aria-label="Founders">
    <div class="container text-center">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>By the Founders</h2>
        <span class="section-line"></span>
      </div>

      <div class="founders-row reveal">
        <div class="founder">
          <div class="image-wrapper">
            <img src="/assets/hero/antima.jpg" alt="Antima" class="founder-photo" width="240" height="300" loading="lazy" />
          </div>
          <h3>Antima</h3>
          <p class="text-muted">Co-Founder</p>
        </div>
        <div class="founder">
          <div class="image-wrapper">
            <img src="/assets/hero/shilpa.jpg" alt="Shilpa" class="founder-photo" width="240" height="300" loading="lazy" />
          </div>
          <h3>Shilpa</h3>
          <p class="text-muted">Co-Founder</p>
        </div>
      </div>

      <blockquote class="founder-quote">
        "Where creativity meets elegance, and every celebration becomes an unforgettable experience."
      </blockquote>

      <a href="/about" class="btn-outline">Read Our Story</a>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section testimonial-section" aria-label="Testimonials">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>What Clients Say</h2>
        <span class="section-line"></span>
      </div>

      <div class="testimonial-card">
        <div class="testimonial-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <p class="testimonial-quote">"Walking into our reception felt like stepping into a dream. Every single detail was thought of — from the florals to the lighting. Our guests are still talking about it."</p>
        <p class="testimonial-author">— Priya & James</p>
        <p class="testimonial-date">Wedding, June 2026</p>
      </div>
    </div>
  </section>

  <!-- Portfolio -->
  <section class="section section--cream" aria-label="Portfolio">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Portfolio</h2>
        <span class="section-line"></span>
      </div>

      <div class="gallery-grid reveal-stagger">
        <div class="image-wrapper">
          <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="500" />
        </div>
        <div class="image-wrapper">
          <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop" loading="lazy" width="400" height="500" />
        </div>
        <div class="image-wrapper">
          <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="500" />
        </div>
        <div class="image-wrapper">
          <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements" loading="lazy" width="400" height="500" />
        </div>
      </div>

      <div class="text-center" style="margin-top: 40px;">
        <a href="/portfolio" class="btn-outline">View Full Gallery</a>
      </div>
    </div>
  </section>

  <!-- Floating WhatsApp -->
  <a href="https://wa.me/44131XXXXXXX" class="floating-wa" aria-label="Chat on WhatsApp" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.406h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.972-.992-3.63-.233-.374a9.81 9.81 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.365-1.659a11.882 11.882 0 005.623 1.418h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
</MainLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 80px;
    background: 
      radial-gradient(ellipse at 20% 50%, rgba(217, 162, 168, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 30%, rgba(212, 175, 55, 0.1) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 80%, rgba(28, 59, 50, 0.08) 0%, transparent 50%),
      linear-gradient(180deg, var(--bg-primary) 0%, #F3EDE4 100%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='800' height='600' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23D4AF37' stroke-width='0.8' opacity='0.06'%3E%3Cpath d='M100 500 Q120 400, 150 350 Q180 300, 160 200 Q140 100, 180 50'/%3E%3Cpath d='M150 350 Q180 380, 220 370'/%3E%3Cpath d='M160 250 Q190 270, 210 260'/%3E%3Cpath d='M700 500 Q680 400, 650 350 Q620 300, 640 200 Q660 100, 620 50'/%3E%3Cpath d='M650 350 Q620 380, 580 370'/%3E%3Cpath d='M640 250 Q610 270, 590 260'/%3E%3Ccircle cx='400' cy='100' r='30'/%3E%3Ccircle cx='400' cy='100' r='45'/%3E%3Ccircle cx='400' cy='100' r='60'/%3E%3Cpath d='M350 500 Q370 450, 400 420 Q430 450, 450 500'/%3E%3Cpath d='M370 450 Q400 430, 430 450'/%3E%3C/g%3E%3Cg fill='%23D9A2A8' opacity='0.04'%3E%3Ccircle cx='200' cy='150' r='40'/%3E%3Ccircle cx='600' cy='200' r='50'/%3E%3Ccircle cx='400' cy='450' r='35'/%3E%3C/g%3E%3C/svg%3E");
    background-size: cover;
    pointer-events: none;
  }

  .hero-bg {
    display: none;
  }

  .hero-overlay {
    display: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 48rem;
  }

  .hero-content h1 {
    color: var(--text-main);
    font-size: 52px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .hero-content h1 { font-size: 36px; }
  }

  .hero-subtitle {
    font-size: 14px;
    letter-spacing: 4px;
    color: var(--accent-gold);
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  .hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-buttons .btn-primary,
  .hero-buttons .btn-secondary {
    display: inline-block;
    padding: 16px 36px;
    background: var(--bg-primary);
    color: var(--text-main);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid var(--bg-primary);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .hero-buttons .btn-primary:hover,
  .hero-buttons .btn-secondary:hover {
    background: var(--accent-gold);
    border-color: var(--accent-gold);
    color: var(--white);
    transform: translateY(-2px);
  }

  @media (max-width: 380px) {
    .hero-buttons { flex-direction: column; align-items: stretch; }
    .hero-buttons .btn-primary,
    .hero-buttons .btn-secondary {
      width: 100%;
      padding: 14px 16px;
      letter-spacing: 1px;
    }
  }

  /* Services grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  .service-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  /* Founders */
  .founders-row {
    display: flex;
    justify-content: center;
    gap: 64px;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .founders-row { flex-direction: column; align-items: center; gap: 32px; }
  }

  .founder {
    text-align: center;
  }

  .founder .image-wrapper {
    border-radius: 120px 120px 0 0;
    display: inline-block;
  }

  .founder-photo {
    width: 240px;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .founder-photo { width: 180px; height: 220px; }
    .founder .image-wrapper { border-radius: 90px 90px 0 0; }
  }

  .founder h3 {
    font-size: 24px;
    margin-top: 16px;
    margin-bottom: 4px;
  }

  .founder-quote {
    background: var(--bg-primary);
    padding: 32px 48px;
    border-left: 4px solid var(--accent-gold);
    border-radius: 0 12px 12px 0;
    max-width: 600px;
    margin: 0 auto 40px;
    font-style: italic;
    font-size: 20px;
    color: var(--text-main);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .founder-quote { padding: 24px 24px; font-size: 17px; }
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .gallery-grid .image-wrapper {
    border-radius: 120px 120px 0 0;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
