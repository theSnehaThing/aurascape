---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About Us' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-gold-light/30">
  <nav class="container-site flex items-center justify-between h-16 md:h-20" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2" aria-label="Aura and Scape - Home">
      <img src="/assets/logos/logo.svg" alt="Aura & Scape" width="40" height="40" class="w-10 h-10 md:w-12 md:h-12" />
      <span class="font-serif text-xl md:text-2xl font-semibold text-teal-deep tracking-wide">
        Aura <span class="text-gold font-light">&</span> Scape
      </span>
    </a>

    <!-- Desktop Nav -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`text-sm font-medium tracking-widest uppercase transition-colors duration-200 hover:text-gold ${
              pathname === link.href ? 'text-gold' : 'text-forest'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/contact"
          class="inline-block px-5 py-2 bg-teal-deep text-cream text-sm font-medium tracking-wide rounded-sm hover:bg-teal-mid transition-colors duration-200"
        >
          Plan Your Event
        </a>
      </li>
    </ul>

    <!-- Mobile Hamburger -->
    <button
      class="md:hidden p-2 text-teal-deep"
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream border-t border-gold-light/30">
    <ul class="container-site py-4 space-y-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`block py-2 text-sm font-medium tracking-widest uppercase ${
              pathname === link.href ? 'text-gold' : 'text-forest'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contact" class="inline-block mt-2 px-5 py-2 bg-teal-deep text-cream text-sm font-medium rounded-sm">
          Plan Your Event
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>

<style>
  :root {
    --color-teal-deep: #1B4D4A;
    --color-teal-mid: #2D6B67;
    --color-gold: #C9A96E;
    --color-gold-light: #E8D5B0;
    --color-cream: #FFFDF5;
    --color-forest: #2C3E3E;
  }
  .bg-cream\/95 { background-color: rgba(255, 253, 245, 0.95); }
  .text-teal-deep { color: var(--color-teal-deep); }
  .text-gold { color: var(--color-gold); }
  .text-forest { color: var(--color-forest); }
  .text-cream { color: var(--color-cream); }
  .bg-teal-deep { background-color: var(--color-teal-deep); }
  .bg-cream { background-color: var(--color-cream); }
  .border-gold-light\/30 { border-color: rgba(232, 213, 176, 0.3); }
  .font-serif { font-family: "Cormorant Garamond", Georgia, serif; }
  .container-site { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
</style>
