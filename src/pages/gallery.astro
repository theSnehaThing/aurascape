---
import MainLayout from '../layouts/MainLayout.astro';

const galleryItems = [
  { src: '/assets/gallery/1.jpg', alt: 'Elegant wedding mandap with floral arches and golden drapes', category: 'wedding' },
  { src: '/assets/gallery/2.jpg', alt: 'Corporate event stage with pastel florals and ambient lighting', category: 'corporate' },
  { src: '/assets/gallery/3.jpg', alt: 'Intimate dinner party with candlelit tables and rose petals', category: 'private' },
  { src: '/assets/gallery/4.jpg', alt: 'Grand reception hall with hanging flower installations', category: 'wedding' },
  { src: '/assets/gallery/5.jpg', alt: 'Pastel colour palette wedding decor with peacock feathers', category: 'wedding' },
  { src: '/assets/gallery/6.jpg', alt: 'Product launch event with modern decor and LED accents', category: 'corporate' },
  { src: '/assets/gallery/7.jpg', alt: 'Birthday celebration with personalised backdrops and fairy lights', category: 'private' },
  { src: '/assets/gallery/8.jpg', alt: 'Traditional wedding ceremony setup with marigold garlands', category: 'wedding' },
  { src: '/assets/gallery/9.jpg', alt: 'Garden party with string lights and wildflower arrangements', category: 'private' },
  { src: '/assets/gallery/10.jpg', alt: 'Award ceremony stage with elegant draping and floral columns', category: 'corporate' },
  { src: '/assets/gallery/11.jpg', alt: 'Sangeet night dance floor with glittering chandeliers', category: 'wedding' },
  { src: '/assets/gallery/12.jpg', alt: 'Anniversary dinner with rose-tinted tables and vintage decor', category: 'private' },
];

const categories = [
  { key: 'all', label: 'All' },
  { key: 'wedding', label: 'Weddings' },
  { key: 'corporate', label: 'Corporate' },
  { key: 'private', label: 'Private' },
];
---

<MainLayout
  title="Gallery — Aura & Scape | Our Event Decorations & Designs"
  description="Browse our gallery of stunning event decorations. Weddings, corporate events, and private celebrations — each one unique, each one unforgettable."
>
  <section class="page-hero bg-cream" aria-label="Gallery header">
    <div class="container">
      <span class="font-script">Our Work</span>
      <h1>Gallery</h1>
      <div class="divider"></div>
      <p>A collection of moments we've had the honour of bringing to life.</p>
    </div>
  </section>

  <!-- Filters -->
  <div class="container">
    <div class="filter-bar" id="filter-bar" role="tablist" aria-label="Gallery filters">
      {categories.map((cat, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-filter={cat.key}
          class={`filter-btn ${i === 0 ? 'active' : ''}`}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Gallery Grid -->
  <section class="section bg-ivory" style="padding-top: 0;" aria-label="Gallery images">
    <div class="container">
      <div class="gallery-grid" id="gallery-grid">
        {galleryItems.map((item) => (
          <figure
            class="gallery-item"
            data-category={item.category}
            tabindex="0"
            role="button"
            aria-label={`View: ${item.alt}`}
          >
            <img src={item.src} alt={item.alt} loading="lazy" width="600" height="400" />
            <figcaption>
              <span>{item.alt}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" role="dialog" aria-label="Image lightbox" aria-hidden="true">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <img id="lightbox-img" src="" alt="" />
    <p class="lightbox-caption" id="lightbox-caption"></p>
  </div>

  <!-- CTA -->
  <section class="section bg-blush" aria-label="Contact CTA">
    <div class="container text-center">
      <h2>Want Something Like This?</h2>
      <p class="text-forest-light" style="margin: 0.75rem 0 1.5rem;">Every event we do is unique to the people celebrating it.</p>
      <a href="/contact" class="btn">Tell Us Your Vision</a>
    </div>
  </section>
</MainLayout>

<script>
  const filterBar = document.getElementById('filter-bar');
  const items = document.querySelectorAll('.gallery-item');

  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-filter]');
    if (!btn) return;

    filterBar.querySelectorAll('button').forEach(b => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
    });
    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');

    const filter = btn.dataset.filter;
    items.forEach(item => {
      const cat = (item as HTMLElement).dataset.category;
      (item as HTMLElement).style.display = (filter === 'all' || cat === filter) ? '' : 'none';
    });
  });

  // Lightbox
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightboxCaption.textContent = alt;
    lightbox.classList.add('open');
    lightbox.setAttribute('aria-hidden', 'false');
    lightboxClose?.focus();
  }

  function closeLightbox() {
    lightbox?.classList.remove('open');
    lightbox?.setAttribute('aria-hidden', 'true');
  }

  items.forEach(item => {
    const img = item.querySelector('img')!;
    item.addEventListener('click', () => openLightbox(img.src, img.alt));
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img.src, img.alt);
      }
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>
