---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/portfolio', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

const { pathname } = Astro.url;
---

<header class="header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Aura and Scape - Home">
      <img src="/assets/logos/logo-main.jpeg" alt="Aura & Scape" width="200" height="140" />
    </a>

    <nav>
      <ul class="nav">
        {navLinks.map((link) => (
          <li><a href={link.href} class={pathname === link.href ? 'active' : ''}>{link.label}</a></li>
        ))}
        <li><a href="/contact" class="btn">Enquire</a></li>
      </ul>
    </nav>

    <button class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle menu">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href} class={pathname === link.href ? 'active' : ''}>{link.label}</a></li>
      ))}
      <li><a href="/contact" class="btn">Enquire</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('open');
  });
</script>
