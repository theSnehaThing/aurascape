---
import MainLayout from '../layouts/MainLayout.astro';
import Ornament from '../components/Ornament.astro';

const features = [
  { icon: '🌸', label: 'Stunning Decor' },
  { icon: '✨', label: 'Beautiful Events' },
  { icon: '💫', label: 'Unique Experiences' },
  { icon: '💝', label: 'Personalised Touch' },
  { icon: '⭐', label: 'Magical Memories' },
];
---

<MainLayout
  title="Aura & Scape — Luxury Event Planning & Decoration | Where Memories Become Magic"
  description="Aura & Scape is a luxury event planning and decoration company by Antima & Shilpa. We bring your vision to life with stunning decor, beautiful events, and unique experiences."
>
  <!-- Hero — matches reference layout -->
  <section class="hero section--decorated" aria-label="Hero">
    <Ornament />
    <Ornament position="bottom-right" />
    <img src="/assets/hero/hero-bg.jpg" alt="" class="hero-bg" loading="eager" width="1920" height="1080" />
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1 class="hero-title">
        Aura <span class="amp">&</span> Scape
      </h1>

      <p class="hero-tagline">Events &nbsp;✦&nbsp; Decor &nbsp;✦&nbsp; Experiences</p>

      <p class="hero-byline">By Antima & Shilpa</p>

      <div class="hero-divider">
        <span class="hero-divider-line"></span>
        <span class="hero-divider-diamond">✦</span>
        <span class="hero-divider-line"></span>
      </div>

      <p class="hero-subheading">Something magical is coming!</p>
      <p class="hero-launching">We're Launching</p>

      <p class="hero-desc">
        Introducing Aura & Scape — where creativity meets elegance, and every
        celebration becomes an unforgettable experience. From dreamy backdrops
        to statement décor, we bring your vision to life, one magical moment
        at a time.
      </p>

      <p class="hero-motto">Where Memories Become Magic</p>
      <span class="hero-heart">♥</span>

      <!-- 5 Feature Icons -->
      <div class="hero-features" role="list" aria-label="Our specialities">
        {features.map((f) => (
          <div class="hero-feature" role="listitem">
            <span class="hero-feature-icon" aria-hidden="true">{f.icon}</span>
            <span class="hero-feature-label">{f.label}</span>
          </div>
        ))}
      </div>

      <!-- Full-width CTA -->
      <a href="/contact" class="hero-cta">
        Let's make your next celebration extraordinary! ♥
      </a>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="section section--ivory" aria-label="Featured work">
    <div class="container">
      <div class="text-center reveal">
        <h2>A Glimpse of Our Work</h2>
        <div class="divider"></div>
      </div>

      <div class="gallery-strip reveal-stagger">
        <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop with golden arches" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements for celebration" loading="lazy" width="400" height="400" />
      </div>

      <div class="text-center">
        <a href="/gallery" class="link-gold">View Full Gallery →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--cream section--decorated" aria-label="What clients say">
    <Ornament />
    <Ornament position="bottom-right" />
    <div class="container">
      <div class="text-center reveal">
        <h2>Kind Words</h2>
        <div class="divider"></div>
      </div>

      <div class="testimonials-grid reveal-stagger">
        <div class="testimonial">
          <blockquote>"The mandap looked like something from a dream. Every single detail was perfect."</blockquote>
          <footer>— Priya & Ramesh, Wedding</footer>
        </div>
        <div class="testimonial">
          <blockquote>"Our office anniversary felt like a proper celebration for the first time. Flawless execution."</blockquote>
          <footer>— Meera, Corporate Events</footer>
        </div>
        <div class="testimonial">
          <blockquote>"They took my vague idea and turned it into something I didn't even know was possible."</blockquote>
          <footer>— Ananya, Birthday Surprise</footer>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--blush" aria-label="Call to action">
    <div class="container text-center reveal">
      <h2>Ready to Create Something Beautiful?</h2>
      <p class="section-intro">Tell us about your vision. We'll make it real.</p>
      <a href="/contact" class="btn">Start Planning</a>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero — matches reference design */
  .hero {
    min-height: 100vh;
    padding-top: 5rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 2rem 1.5rem;
    max-width: 56rem;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .hero-tagline {
    font-size: clamp(0.7rem, 2vw, 0.9rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.75);
    margin-bottom: 1rem;
  }

  .hero-byline {
    font-family: var(--font-script);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    width: 200px;
    justify-content: center;
  }

  .hero-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold));
  }

  .hero-divider-line:last-child {
    background: linear-gradient(to left, transparent, var(--gold));
  }

  .hero-divider-diamond {
    color: var(--gold);
    font-size: 0.7rem;
  }

  .hero-subheading {
    font-size: clamp(0.75rem, 2vw, 0.9rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.7);
    margin-bottom: 0.5rem;
  }

  .hero-launching {
    font-family: var(--font-script);
    font-size: clamp(2.5rem, 7vw, 4rem);
    color: var(--teal-deep);
    margin-bottom: 1.5rem;
    line-height: 1.1;
  }

  .hero-desc {
    font-size: clamp(0.9rem, 2vw, 1rem);
    color: rgba(17, 17, 17, 0.78);
    max-width: 28rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .hero-motto {
    font-family: var(--font-script);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--teal-deep);
    margin-bottom: 0.25rem;
  }

  .hero-heart {
    color: var(--rose);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  /* 5 Feature icons */
  .hero-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin-bottom: 2rem;
    padding: 0 1rem;
  }

  @media (min-width: 768px) {
    .hero-features {
      gap: 0.75rem 2rem;
    }
  }

  .hero-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-feature-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(201, 169, 110, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    background: rgba(245, 237, 216, 0.6);
  }

  .hero-feature-label {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.75);
    font-weight: 500;
    text-align: center;
  }

  /* Full-width CTA button */
  .hero-cta {
    display: block;
    width: 100%;
    max-width: 400px;
    padding: 1rem 2rem;
    background-color: #0d2927;
    color: #fff;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: background-color 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    background-color: #1B4D4A;
    transform: translateY(-2px);
  }
</style>
