---
import MainLayout from '../layouts/MainLayout.astro';

const photos = [
  { src: '/assets/gallery/1.jpg', alt: 'Elegant floral wedding arch with pastel blooms' },
  { src: '/assets/gallery/2.jpg', alt: 'Luxurious event table setting with gold accents' },
  { src: '/assets/gallery/3.jpg', alt: 'Romantic candlelit dinner with floral centrepieces' },
  { src: '/assets/gallery/4.jpg', alt: 'Grand ballroom decorated with draping and lights' },
  { src: '/assets/gallery/5.jpg', alt: 'Pastel flower arrangements for a spring wedding' },
  { src: '/assets/gallery/6.jpg', alt: 'Elegant ceremony backdrop with fresh flowers' },
  { src: '/assets/gallery/7.jpg', alt: 'Outdoor event with fairy lights and greenery' },
  { src: '/assets/gallery/8.jpg', alt: 'Statement floral installation for a reception' },
  { src: '/assets/gallery/9.jpg', alt: 'Intimate anniversary dinner with roses' },
  { src: '/assets/gallery/10.jpg', alt: 'Grand entrance with floral columns' },
  { src: '/assets/gallery/11.jpg', alt: 'Elegant cake table with gold detailing' },
  { src: '/assets/gallery/12.jpg', alt: 'Garden party setup with pastel draping' },
];
---

<MainLayout
  title="Portfolio - Aura & Scape"
  description="Browse our portfolio of luxury events, decor installations, and memorable celebrations by Aura & Scape, Edinburgh."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Portfolio</h1>
      <div class="divider"></div>
      <p class="text-muted" style="max-width: 500px; margin: 16px auto 0;">A glimpse of the spaces we've crafted. Every event is unique — yours will be too.</p>
    </div>
  </section>

  <!-- Gallery Grid -->
  <section class="section section--cream">
    <div class="container">
      <div class="filter-bar reveal">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="wedding">Weddings</button>
        <button class="filter-btn" data-filter="corporate">Corporate</button>
        <button class="filter-btn" data-filter="private">Private</button>
      </div>

      <div class="gallery-grid reveal-stagger">
        {photos.map((photo) => (
          <div class="gallery-item">
            <img src={photo.src} alt={photo.alt} loading="lazy" width="400" height="400" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--rose">
    <div class="container text-center">
      <h2>Ready to See Yours Here?</h2>
      <p class="text-muted" style="max-width: 480px; margin: 16px auto 32px;">Let's create something beautiful together. Your celebration belongs in this gallery.</p>
      <a href="/contact" class="btn-primary">Start Planning</a>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    padding: 120px 48px 60px;
    background: var(--bg-primary);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 100px 20px 40px; }
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 10px 20px;
    background: transparent;
    border: 1px solid var(--border-light);
    border-radius: 24px;
    font-size: 13px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--text-main);
    color: var(--bg-primary);
    border-color: var(--text-main);
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  @media (max-width: 768px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .gallery-grid { grid-template-columns: 1fr; }
  }

  .gallery-item {
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover {
    transform: scale(1.02);
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>

<script>
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelector('.filter-btn.active')?.classList.remove('active');
      btn.classList.add('active');
      // Filter logic would go here when categories are assigned
    });
  });
</script>
