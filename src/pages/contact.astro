---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Enquire - Aura & Scape | Luxury Event Planning & Decoration in Edinburgh"
  description="Start your enquiry with Aura & Scape — luxury event planning, decor and experiences in Edinburgh, Scotland. Tell us about your celebration and book a consultation."
  image="/assets/hero/og-contact.jpg"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Start Your Story</h1>
      <div class="divider"></div>
      <p class="text-muted" style="max-width: 500px; margin: 16px auto 0;">Tell us about your celebration and we'll be in touch soon with next steps and a consultation time.</p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="section section--cream">
    <div class="container">
      <div class="form-container reveal">
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="inquiry-form" id="enquiry-form" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name <span class="req">*</span></label>
              <input type="text" id="name" name="name" placeholder="Your name" required />
              <p class="field-error" data-error-for="name" hidden></p>
            </div>
            <div class="form-group">
              <label for="email">Email Address <span class="req">*</span></label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
              <p class="field-error" data-error-for="email" hidden></p>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="event-type">Event Type <span class="req">*</span></label>
              <select id="event-type" name="event-type" required>
                <option value="" disabled selected>Select an event type</option>
                <option value="wedding">Wedding</option>
                <option value="private">Private Celebration</option>
                <option value="corporate">Corporate</option>
                <option value="other">Other</option>
              </select>
              <p class="field-error" data-error-for="event-type" hidden></p>
            </div>
            <div class="form-group">
              <label for="date">Event Date <span class="req">*</span></label>
              <input type="date" id="date" name="date" required />
              <p class="field-error" data-error-for="date" hidden></p>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="venue">Location / Venue <span class="req">*</span></label>
              <input type="text" id="venue" name="venue" placeholder="Where is your event?" required />
              <p class="field-error" data-error-for="venue" hidden></p>
            </div>
            <div class="form-group">
              <label for="guests">Guest Count <span class="req">*</span></label>
              <input type="number" id="guests" name="guests" placeholder="e.g. 120" min="1" required />
              <p class="field-error" data-error-for="guests" hidden></p>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone / WhatsApp <span class="opt">optional</span></label>
              <input type="tel" id="phone" name="phone" placeholder="If you'd like a call" />
            </div>
            <div class="form-group">
              <label for="services">Services of Interest <span class="opt">optional</span></label>
              <select id="services" name="services">
                <option value="" selected>Not sure yet</option>
                <option value="events">Events</option>
                <option value="decor">Decor</option>
                <option value="experiences">Experiences</option>
                <option value="personalised">Personalised Touch</option>
                <option value="memories">Magical Memories</option>
                <option value="full">Full Package</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="budget">Estimated Budget <span class="opt">optional</span></label>
            <select id="budget" name="budget">
              <option value="" selected>Prefer not to say</option>
              <option value="under-5k">Under £5,000</option>
              <option value="5k-10k">£5,000 – £10,000</option>
              <option value="10k-25k">£10,000 – £25,000</option>
              <option value="25k-plus">£25,000+</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us about your vision — colours, themes, must-haves, anything that comes to mind..."></textarea>
          </div>

          <button type="submit" class="submit-btn">Send Enquiry</button>
        </form>

        <div class="form-success" id="form-success" hidden>
          <h3>Thank you — your enquiry is on its way.</h3>
          <p class="text-muted">We've received your details and will be in touch soon with next steps and a consultation time.</p>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="contact-info">
        <div class="contact-card">
          <h3>Email</h3>
          <a href="mailto:auranscape@gmail.com">auranscape@gmail.com</a>
        </div>
        <div class="contact-card">
          <h3>Phone</h3>
          <a href="tel:+44131XXXXXXX">+44 131 XXXX XXX</a>
        </div>
        <div class="contact-card">
          <h3>Instagram</h3>
          <a href="https://www.instagram.com/auranscape" target="_blank" rel="noopener">@auranscape</a>
        </div>
        <div class="contact-card">
          <h3>Location</h3>
          <p>Edinburgh, Scotland</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    padding: 120px 48px 60px;
    background: var(--bg-primary);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 100px 20px 40px; }
  }

  .form-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-light);
  }

  @media (max-width: 768px) {
    .form-container { padding: 32px 20px; }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .submit-btn {
    width: 100%;
    height: 52px;
    background: var(--text-main);
    color: var(--bg-primary);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .submit-btn:hover {
    background: var(--accent-gold);
    transform: translateY(-2px);
  }

  .req {
    color: var(--accent-gold);
    font-weight: 600;
  }

  .opt {
    color: var(--text-muted);
    font-size: 12px;
    text-transform: none;
    letter-spacing: 0;
  }

  .field-error {
    color: #A3453F;
    font-size: 13px;
    margin-top: 6px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--accent-gold);
    outline-offset: 1px;
  }

  .form-group input[aria-invalid="true"],
  .form-group select[aria-invalid="true"] {
    border-color: #A3453F;
  }

  .form-success {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px;
    text-align: center;
    background: var(--bg-secondary);
    border: 1px solid var(--border-gold, var(--border-light));
    border-radius: 16px;
  }

  .form-success h3 {
    font-size: 26px;
    margin-bottom: 12px;
  }

  .form-success p { margin-bottom: 0; }

  /* Contact info cards */
  .contact-info {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    margin-top: 48px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 600px) {
    .contact-info { grid-template-columns: 1fr; }
  }

  .contact-card {
    text-align: center;
    padding: 24px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-rose);
    border-radius: 12px;
  }

  .contact-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
    color: var(--text-main);
  }

  .contact-card a,
  .contact-card p {
    font-size: 14px;
    color: var(--text-muted);
  }

  .contact-card a:hover {
    color: var(--accent-gold);
  }
</style>

<script>
  const form = document.getElementById('enquiry-form');
  const success = document.getElementById('form-success');
  if (form) {
    const messages = {
      name: 'Please tell us your name.',
      email: 'Please enter a valid email address.',
      'event-type': 'Please choose an event type.',
      date: 'Please pick a date (or month).',
      venue: 'Please tell us where the event is.',
      guests: 'Please give an approximate guest count.',
    };
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let valid = true;
      let firstBad = null;
      for (const [field, msg] of Object.entries(messages)) {
        const el = form.elements[field];
        const errEl = form.querySelector(`[data-error-for="${field}"]`);
        let bad = false;
        if (!el.value.trim()) bad = true;
        else if (field === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(el.value)) bad = true;
        else if (field === 'guests' && (isNaN(Number(el.value)) || Number(el.value) < 1)) bad = true;
        el.setAttribute('aria-invalid', bad ? 'true' : 'false');
        if (errEl) errEl.hidden = !bad;
        if (bad) {
          valid = false;
          if (!firstBad) firstBad = el;
        }
      }
      if (!valid) {
        firstBad.focus();
        return;
      }
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
