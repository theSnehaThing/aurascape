---
import MainLayout from '../layouts/MainLayout.astro';
import Ornament from '../components/Ornament.astro';
---

<MainLayout
  title="Aura & Scape - Events, Decor, Experiences"
  description="Aura & Scape — Where creativity meets elegance. Events, Decor, Experiences by Antima & Shilpa. Edinburgh, Scotland."
>
  <!-- Hero — full photo background -->
  <section class="hero" aria-label="Hero">
    <img src="/assets/hero/hero-bg.jpg" alt="" class="hero-bg" loading="eager" width="1920" height="1080" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-subtitle">Something magical is coming!</p>
      <h1 class="hero-launching">We're Launching</h1>
      <p class="hero-desc">Where creativity meets elegance, and every celebration becomes an unforgettable experience.</p>
      <div class="hero-divider">
        <span class="hero-line"></span>
        <span class="hero-heart">♥</span>
        <span class="hero-line"></span>
      </div>
      <p class="hero-motto">Where Memories Become Magic</p>
      <span class="hero-small-heart">♡</span>
    </div>
  </section>

  <!-- Services -->
  <section class="section section--cream" aria-label="Services">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Services</h2>
        <span class="section-line"></span>
      </div>

      <div class="services-row">
        <div class="service-item">
          <div class="service-icon">
            <!-- Arch icon -->
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 42V18C8 10 14 4 24 4s16 6 16 14v24"/>
              <path d="M14 42V20c0-5 3-9 10-9s10 4 10 9v22"/>
              <line x1="6" y1="42" x2="42" y2="42"/>
              <path d="M12 30c0-2 1.5-4 3-4s3 2 3 4"/>
              <path d="M30 30c0-2 1.5-4 3-4s3 2 3 4"/>
            </svg>
          </div>
          <h3>Events</h3>
          <p>Where creativity meets elegance, and every celebration becomes.</p>
        </div>

        <div class="service-item">
          <div class="service-icon">
            <!-- Curtains icon -->
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="8" y="6" width="32" height="36" rx="1"/>
              <path d="M8 6h32"/>
              <path d="M16 6v36"/>
              <path d="M32 6v36"/>
              <path d="M16 24c2-2 4-3 8-3s6 1 8 3"/>
              <line x1="8" y1="42" x2="40" y2="42"/>
            </svg>
          </div>
          <h3>Decor</h3>
          <p>From dreamy backdrops to statement décor, we bring your vision to life.</p>
        </div>

        <div class="service-item">
          <div class="service-icon">
            <!-- Lanterns icon -->
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 8v4"/><path d="M12 12c-3 0-4 2-4 5v3c0 3 1 5 4 5s4-2 4-5v-3c0-3-1-5-4-5z"/>
              <line x1="12" y1="25" x2="12" y2="40"/>
              <path d="M24 6v4"/><path d="M24 10c-3 0-4 2-4 5v3c0 3 1 5 4 5s4-2 4-5v-3c0-3-1-5-4-5z"/>
              <line x1="24" y1="23" x2="24" y2="40"/>
              <path d="M36 8v4"/><path d="M36 12c-3 0-4 2-4 5v3c0 3 1 5 4 5s4-2 4-5v-3c0-3-1-5-4-5z"/>
              <line x1="36" y1="25" x2="36" y2="40"/>
            </svg>
          </div>
          <h3>Experiences</h3>
          <p>A curated experience scene and curated event unexperience.</p>
        </div>

        <div class="service-item">
          <div class="service-icon">
            <!-- Hands/heart icon -->
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 36s-10-6.5-10-14c0-4 3-7 7-7 1.5 0 2.5.5 3 1.5.5-1 1.5-1.5 3-1.5 4 0 7 3 7 7 0 7.5-10 14-10 14z"/>
              <path d="M10 30c-2 3-3 7-2 10"/>
              <path d="M38 30c2 3 3 7 2 10"/>
            </svg>
          </div>
          <h3>Personalised Touch</h3>
          <p>A warm hand-heart, marnment and every personalised touch.</p>
        </div>

        <div class="service-item">
          <div class="service-icon">
            <!-- Star/sparkle icon -->
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M24 6v6M24 36v6M6 24h6M36 24h6M11 11l4 4M33 33l4 4M11 37l4-4M33 11l4 4"/>
              <path d="M24 16l2 5 5 2-5 2-2 5-2-5-5-2 5-2z"/>
            </svg>
          </div>
          <h3>Magical Memories</h3>
          <p>Magical magical memories osds and magical memories.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="section section--ivory" aria-label="Founders">
    <div class="container text-center">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>By the Founders</h2>
        <span class="section-line"></span>
      </div>

      <div class="founders">
        <div class="founders-photos">
          <img src="/assets/hero/team.jpg" alt="Antima" class="founder-photo" width="80" height="80" loading="lazy" />
          <img src="/assets/hero/team.jpg" alt="Shilpa" class="founder-photo" width="80" height="80" loading="lazy" />
        </div>
        <p class="founders-name">By Antima & Shilpa</p>
        <p class="founders-tagline">Dream, Decorate, Celebrate</p>
      </div>

      <a href="/contact" class="btn btn-gold">Book Your Consultation</a>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="section section--cream" aria-label="Portfolio">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Portfolio</h2>
        <span class="section-line"></span>
      </div>

      <div class="gallery-strip reveal-stagger">
        <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements" loading="lazy" width="400" height="400" />
      </div>

      <div class="text-center">
        <a href="/gallery" class="link-gold">View Full Gallery →</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 4.5rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.1) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 48rem;
  }

  .hero-subtitle {
    font-size: clamp(0.7rem, 2vw, 0.85rem);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #C9A96E;
    margin-bottom: 0.5rem;
  }

  .hero-launching {
    font-family: var(--font-script);
    font-size: clamp(2.8rem, 8vw, 4.5rem);
    color: #1B4D4A;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .hero-desc {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: #2C3E3E;
    max-width: 28rem;
    margin: 0 auto 1.5rem;
    line-height: 1.6;
  }

  .hero-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .hero-line {
    width: 60px;
    height: 1px;
    background: #C9A96E;
  }

  .hero-heart {
    color: #C9A96E;
    font-size: 0.8rem;
  }

  .hero-motto {
    font-family: var(--font-script);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: #1B4D4A;
  }

  .hero-small-heart {
    color: #C9A96E;
    font-size: 0.9rem;
    display: block;
    margin-top: 0.5rem;
  }

  /* Section heading with lines */
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .section-heading h2 {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .section-line {
    flex: 1;
    max-width: 120px;
    height: 1px;
    background: #C9A96E;
  }

  /* Services row */
  .services-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .services-row {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.5rem;
    }
  }

  .service-item {
    text-align: center;
  }

  .service-icon {
    color: #C9A96E;
    margin-bottom: 1rem;
    display: flex;
    justify-content: center;
  }

  .service-item h3 {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    color: #1B4D4A;
  }

  .service-item p {
    font-size: 0.8rem;
    color: rgba(17, 17, 17, 0.7);
    line-height: 1.5;
  }

  /* Founders */
  .founders {
    margin-bottom: 2rem;
  }

  .founders-photos {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .founder-photo {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #C9A96E;
  }

  .founders-name {
    font-family: var(--font-script);
    font-size: 1.6rem;
    color: #1B4D4A;
    margin-bottom: 0.25rem;
  }

  .founders-tagline {
    font-size: 0.9rem;
    color: rgba(17, 17, 17, 0.7);
    letter-spacing: 0.05em;
  }

  /* Gold button */
  .btn-gold {
    background-color: #C9A96E;
    color: #fff;
    border: none;
    padding: 0.9rem 2.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background-color 0.2s;
  }

  .btn-gold:hover {
    background-color: #B8944E;
  }
</style>
