---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Aura & Scape — Luxury Event Planning & Decoration | Where Memories Become Magic"
  description="Aura & Scape is a luxury event planning and decoration company by Antima & Shilpa. We bring your vision to life with stunning decor, beautiful events, and unique experiences."
>
  <!-- Hero -->
  <section class="hero" aria-label="Hero">
    <img src="/assets/hero/hero-bg.jpg" alt="" class="hero-bg" loading="eager" width="1920" height="1080" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <p class="hero-script">Something magical is coming</p>
      <h1>Aura <span style="color: var(--gold); font-weight: 300;">&</span> Scape</h1>
      <p class="hero-tagline">Events &nbsp;·&nbsp; Decor &nbsp;·&nbsp; Experiences</p>
      <div class="divider"></div>
      <p class="hero-quote">"Where Memories Become Magic"</p>
      <p class="hero-desc">From dreamy backdrops to statement décor, we bring your vision to life, one magical moment at a time.</p>
      <a href="/contact" class="btn">Plan Your Event</a>
    </div>
  </section>

  <!-- Services -->
  <section class="section bg-cream" aria-label="Our services">
    <div class="container">
      <div class="text-center">
        <h2>What We Do</h2>
        <div class="divider"></div>
        <p class="text-forest-light max-w-lg mx-auto">Every celebration deserves to be extraordinary. Here's how we make it happen.</p>
      </div>

      <div class="services-grid">
        <div class="service">
          <div class="service-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m6.364-14.364l-12.728 12.728M21 12H3" /></svg>
          </div>
          <h3>Stunning Decor</h3>
          <p>From florals to fairy lights, we craft spaces that take your breath away. Every detail curated, every corner considered.</p>
        </div>

        <div class="service">
          <div class="service-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="4" /><line x1="12" y1="3" x2="12" y2="5" /><line x1="12" y1="19" x2="12" y2="21" /><line x1="3" y1="12" x2="5" y2="12" /><line x1="19" y1="12" x2="21" y2="12" /></svg>
          </div>
          <h3>Beautiful Events</h3>
          <p>Weddings, corporate gatherings, intimate celebrations — we plan seamless experiences from concept to the final sparkle.</p>
        </div>

        <div class="service">
          <div class="service-icon">
            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.714-1.607-2.376-2.733-4.312-2.733C5.099 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
          </div>
          <h3>Unique Experiences</h3>
          <p>Personalised touches that make your event unmistakably yours. Curated moments your guests will remember for years.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="section bg-ivory" aria-label="Featured work">
    <div class="container">
      <div class="text-center">
        <h2>A Glimpse</h2>
        <div class="divider"></div>
      </div>

      <div class="gallery-strip">
        <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop with golden arches" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements for celebration" loading="lazy" width="400" height="400" />
      </div>

      <div class="text-center" style="margin-top: 2rem;">
        <a href="/gallery" class="link-gold">View Full Gallery →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section bg-cream" aria-label="What clients say">
    <div class="container">
      <div class="text-center">
        <h2>Kind Words</h2>
        <div class="divider"></div>
      </div>

      <div class="testimonials-grid">
        <div class="testimonial">
          <blockquote>"The mandap looked like something from a dream. Every single detail was perfect."</blockquote>
          <footer>— Priya & Ramesh, Wedding</footer>
        </div>
        <div class="testimonial">
          <blockquote>"Our office anniversary felt like a proper celebration for the first time. Flawless execution."</blockquote>
          <footer>— Meera, Corporate Events</footer>
        </div>
        <div class="testimonial">
          <blockquote>"They took my vague idea and turned it into something I didn't even know was possible."</blockquote>
          <footer>— Ananya, Birthday Surprise</footer>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-blush" aria-label="Call to action">
    <div class="container text-center">
      <h2>Ready to Create Something Beautiful?</h2>
      <p class="text-forest-light max-w-lg mx-auto" style="margin: 1rem auto 2rem;">Tell us about your vision. We'll make it real.</p>
      <a href="/contact" class="btn">Start Planning</a>
    </div>
  </section>
</MainLayout>
