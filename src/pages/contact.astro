---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contact - Aura & Scape"
  description="Book a consultation or get in touch with Aura & Scape. Luxury event planning and decoration in Edinburgh, Scotland."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Get in Touch</h1>
      <div class="divider"></div>
      <p class="text-muted" style="max-width: 500px; margin: 16px auto 0;">Tell us about your celebration and we'll get back to you within 24 hours.</p>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="section section--cream">
    <div class="container">
      <div class="form-container reveal">
        <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="inquiry-form">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" placeholder="Your name" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="date">Event Date</label>
              <input type="date" id="date" name="date" required />
            </div>
            <div class="form-group">
              <label for="venue">Location / Venue</label>
              <input type="text" id="venue" name="venue" placeholder="Where is your event?" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="guests">Guest Count</label>
              <input type="number" id="guests" name="guests" placeholder="e.g. 120" min="1" />
            </div>
            <div class="form-group">
              <label for="service">Service Needed</label>
              <select id="service" name="service" required>
                <option value="" disabled selected>Select a service</option>
                <option value="events">Events</option>
                <option value="decor">Decor</option>
                <option value="experiences">Experiences</option>
                <option value="full">Full Package</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="budget">Estimated Budget</label>
            <select id="budget" name="budget">
              <option value="" disabled selected>Select a range</option>
              <option value="under-5k">Under £5,000</option>
              <option value="5k-10k">£5,000 – £10,000</option>
              <option value="10k-25k">£10,000 – £25,000</option>
              <option value="25k-plus">£25,000+</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us about your vision — colours, themes, must-haves, anything that comes to mind..." required></textarea>
          </div>

          <button type="submit" class="submit-btn">Send Inquiry</button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="contact-info">
        <div class="contact-card">
          <h3>Email</h3>
          <a href="mailto:hello@aurascape.in">hello@aurascape.in</a>
        </div>
        <div class="contact-card">
          <h3>Phone</h3>
          <a href="tel:+44131XXXXXXX">+44 131 XXXX XXX</a>
        </div>
        <div class="contact-card">
          <h3>Location</h3>
          <p>Edinburgh, Scotland</p>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    padding: 120px 48px 60px;
    background: var(--bg-primary);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 100px 20px 40px; }
  }

  .form-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px;
    background: var(--bg-secondary);
    border-radius: 16px;
    border: 1px solid var(--border-light);
  }

  @media (max-width: 768px) {
    .form-container { padding: 32px 20px; }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .submit-btn {
    width: 100%;
    height: 52px;
    background: var(--text-main);
    color: var(--bg-primary);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 8px;
  }

  .submit-btn:hover {
    background: var(--accent-gold);
    transform: translateY(-2px);
  }

  /* Contact info cards */
  .contact-info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 48px;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 600px) {
    .contact-info { grid-template-columns: 1fr; }
  }

  .contact-card {
    text-align: center;
    padding: 24px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-rose);
    border-radius: 12px;
  }

  .contact-card h3 {
    font-size: 16px;
    margin-bottom: 8px;
    color: var(--text-main);
  }

  .contact-card a,
  .contact-card p {
    font-size: 14px;
    color: var(--text-muted);
  }

  .contact-card a:hover {
    color: var(--accent-gold);
  }
</style>
