---
// Cookie consent banner - GDPR compliant
// Only loads analytics/tracking after user consents
// Stores preference in localStorage
---

<div
  id="cookie-banner"
  class="fixed bottom-0 left-0 right-0 z-50 bg-ivory border-t border-gold-light/50 shadow-lg"
  role="dialog"
  aria-label="Cookie consent"
  hidden
>
  <div class="container-site py-4 md:py-5 flex flex-col md:flex-row items-center gap-3 md:gap-6">
    <p class="text-sm text-forest flex-1 text-center md:text-left">
      We use cookies to enhance your browsing experience and analyse our traffic.
      We'll only store cookies if you accept. Read our
      <a href="/privacy" class="text-teal underline hover:text-gold transition-colors">Privacy Policy</a>.
    </p>
    <div class="flex gap-3 shrink-0">
      <button
        id="cookie-reject"
        class="px-4 py-2 text-sm font-medium border border-teal-deep text-teal-deep rounded-sm hover:bg-teal-deep hover:text-cream transition-colors"
      >
        Decline
      </button>
      <button
        id="cookie-accept"
        class="px-4 py-2 text-sm font-medium bg-teal-deep text-cream rounded-sm hover:bg-teal-mid transition-colors"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'aurascape.cookie-consent';

  function init() {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    const stored = localStorage.getItem(CONSENT_KEY);
    if (!stored) {
      banner.removeAttribute('hidden');
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'accepted');
      banner.setAttribute('hidden', '');
      // Load analytics here if needed
      // e.g., initializePlausible();
    });

    document.getElementById('cookie-reject')?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'rejected');
      banner.setAttribute('hidden', '');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .bg-ivory { background-color: #FDF8F0; }
  .border-gold-light\/50 { border-color: rgba(232, 213, 176, 0.5); }
  .text-forest { color: #2C3E3E; }
  .text-teal { color: #1B4D4A; }
  .hover\:text-gold:hover { color: #C9A96E; }
  .border-teal-deep { border-color: #1B4D4A; }
  .text-teal-deep { color: #1B4D4A; }
  .hover\:bg-teal-deep:hover { background-color: #1B4D4A; }
  .hover\:text-cream:hover { color: #FFFDF5; }
  .bg-teal-deep { background-color: #1B4D4A; }
  .text-cream { color: #FFFDF5; }
  .hover\:bg-teal-mid:hover { background-color: #2D6B67; }
  .container-site { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
</style>
