---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Aura & Scape — Luxury Event Planning & Decoration | Where Memories Become Magic"
  description="Aura & Scape is a luxury event planning and decoration company by Antima & Shilpa. We bring your vision to life with stunning decor, beautiful events, and unique experiences."
>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden" aria-label="Hero">
    <div class="absolute inset-0">
      <img
        src="/assets/hero/hero-bg.svg"
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-cream/80 via-cream/60 to-cream"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
      <p class="font-script text-gold text-2xl md:text-4xl mb-4">Something magical is coming</p>
      <h1 class="font-serif text-4xl md:text-6xl lg:text-7xl font-medium text-teal-deep mb-4">
        Aura <span class="text-gold font-light">&</span> Scape
      </h1>
      <p class="text-sm md:text-base tracking-[0.3em] uppercase text-forest/70 mb-6">
        Events &nbsp;·&nbsp; Decor &nbsp;·&nbsp; Experiences
      </p>
      <div class="divider-gold" />
      <p class="font-serif text-lg md:text-xl text-forest/80 italic mb-8">
        "Where Memories Become Magic"
      </p>
      <p class="text-forest/70 text-sm md:text-base max-w-xl mx-auto mb-10 leading-relaxed">
        From dreamy backdrops to statement décor, we bring your vision to life,
        one magical moment at a time.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-3 bg-teal-deep text-cream font-medium tracking-wide rounded-sm hover:bg-teal-mid transition-colors duration-200"
      >
        Plan Your Event
      </a>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section bg-cream" aria-label="Our services">
    <div class="container-site">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl md:text-4xl text-teal-deep mb-3">What We Do</h2>
        <div class="divider-gold" />
        <p class="text-forest/70 max-w-lg mx-auto">
          Every celebration deserves to be extraordinary. Here's how we make it happen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
        <!-- Service 1 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-gold-pale flex items-center justify-center">
            <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18m6.364-14.364l-12.728 12.728M21 12H3" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-teal-deep mb-2">Stunning Decor</h3>
          <p class="text-forest/70 text-sm leading-relaxed">
            From florals to fairy lights, we craft spaces that take your breath away.
            Every detail curated, every corner considered.
          </p>
        </div>

        <!-- Service 2 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-gold-pale flex items-center justify-center">
            <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9c.83 0 1.6-.15 2.32-.42a7.5 7.5 0 004.68 1.42 7.5 7.5 0 002.5-.42c.72.27 1.49.42 2.32.42" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-teal-deep mb-2">Beautiful Events</h3>
          <p class="text-forest/70 text-sm leading-relaxed">
            Weddings, corporate gatherings, intimate celebrations — we plan
            seamless experiences from concept to the final sparkle.
          </p>
        </div>

        <!-- Service 3 -->
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-5 rounded-full bg-gold-pale flex items-center justify-center">
            <svg class="w-7 h-7 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733l-.003.005-.003-.005C11.144 4.876 9.482 3.75 7.547 3.75 4.958 3.75 2.86 5.765 2.86 8.25c0 2.485 2.098 4.5 4.687 4.5.391 0 .772-.05 1.137-.144a6.523 6.523 0 014.316 0c.365.094.746.144 1.137.144 2.589 0 4.688-2.015 4.688-4.5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 12.75v9" />
            </svg>
          </div>
          <h3 class="font-serif text-xl text-teal-deep mb-2">Unique Experiences</h3>
          <p class="text-forest/70 text-sm leading-relaxed">
            Personalised touches that make your event unmistakably yours.
            Curated moments your guests will remember for years.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Gallery Strip -->
  <section class="section bg-ivory" aria-label="Featured work">
    <div class="container-site">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl md:text-4xl text-teal-deep mb-3">A Glimpse</h2>
        <div class="divider-gold" />
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <img src="/assets/gallery/preview-1.svg" alt="Elegant floral wedding decoration" class="w-full h-48 md:h-64 object-cover rounded-sm" loading="lazy" />
        <img src="/assets/gallery/preview-2.svg" alt="Luxurious event backdrop with golden arches" class="w-full h-48 md:h-64 object-cover rounded-sm" loading="lazy" />
        <img src="/assets/gallery/preview-3.svg" alt="Romantic candlelit dinner setup" class="w-full h-48 md:h-64 object-cover rounded-sm" loading="lazy" />
        <img src="/assets/gallery/preview-4.svg" alt="Pastel flower arrangements for celebration" class="w-full h-48 md:h-64 object-cover rounded-sm" loading="lazy" />
      </div>

      <div class="text-center mt-8">
        <a href="/gallery" class="text-gold text-sm font-medium tracking-wide hover:underline">
          View Full Gallery →
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section bg-blush" aria-label="Call to action">
    <div class="container-site text-center">
      <h2 class="font-serif text-3xl md:text-4xl text-teal-deep mb-4">Ready to Create Something Beautiful?</h2>
      <p class="text-forest/70 max-w-md mx-auto mb-8">
        Tell us about your vision. We'll make it real.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-3 bg-teal-deep text-cream font-medium tracking-wide rounded-sm hover:bg-teal-mid transition-colors duration-200"
      >
        Start Planning
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .bg-cream { background-color: #FFFDF5; }
  .bg-ivory { background-color: #FDF8F0; }
  .bg-blush { background-color: #F5E6E8; }
  .bg-gold-pale { background-color: #F5EDD8; }
  .text-teal-deep { color: #1B4D4A; }
  .text-teal-mid { color: #2D6B67; }
  .text-gold { color: #C9A96E; }
  .text-forest { color: #2C3E3E; }
  .text-forest\/70 { color: rgba(44, 62, 62, 0.7); }
  .text-forest\/80 { color: rgba(44, 62, 62, 0.8); }
  .text-cream { color: #FFFDF5; }
  .bg-teal-deep { background-color: #1B4D4A; }
  .hover\:bg-teal-mid:hover { background-color: #2D6B67; }
  .font-serif { font-family: "Cormorant Garamond", Georgia, serif; }
  .font-script { font-family: "Great Vibes", cursive; }
  .divider-gold { width: 80px; height: 2px; background: linear-gradient(to right, transparent, #C9A96E, transparent); margin: 1.5rem auto; }
  .container-site { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  .section { padding: 5rem 0; }
  @media (max-width: 768px) { .section { padding: 3rem 0; } }
</style>
