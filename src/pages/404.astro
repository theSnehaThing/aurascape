---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Page Not Found — Aura & Scape"
  description="The page you're looking for doesn't exist. Explore Aura & Scape's services, portfolio and contact page."
>
  <section class="nf">
    <div class="nf-inner">
      <p class="nf-code">404</p>
      <h1>This page has drifted away</h1>
      <p class="nf-text">The page you're looking for doesn't exist — but the magic is still here.</p>
      <div class="nf-links">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/portfolio" class="btn-outline">View the Portfolio</a>
      </div>
    </div>
  </section>

  <style>
    .nf {
      min-height: 60vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 80px 24px;
      background: var(--bg-secondary);
      text-align: center;
    }

    .nf-inner {
      max-width: 520px;
    }

    .nf-code {
      font-family: var(--font-script);
      font-size: 72px;
      line-height: 1;
      color: var(--accent-gold);
      margin-bottom: 12px;
    }

    .nf h1 {
      font-size: 34px;
      margin-bottom: 12px;
    }

    .nf-text {
      color: var(--text-muted);
      margin-bottom: 32px;
      line-height: 1.6;
    }

    .nf-links {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    @media (max-width: 768px) {
      .nf h1 { font-size: 26px; }
      .nf-code { font-size: 56px; }
    }
  </style>
</MainLayout>
