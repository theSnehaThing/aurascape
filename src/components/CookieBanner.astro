<div
  class="cookie-banner"
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="cookie-inner">
    <p class="cookie-text">
      We use a single cookie to remember your consent preference. No tracking, no analytics.
      Read our <a href="/privacy">Privacy Policy</a>.
    </p>
    <div class="cookie-actions">
      <button class="cookie-btn cookie-btn-reject" id="cookie-reject">Decline</button>
      <button class="cookie-btn cookie-btn-accept" id="cookie-accept">Accept</button>
    </div>
  </div>
</div>

<script>
  const CONSENT_KEY = 'aurascape.cookie-consent';

  function init() {
    const banner = document.getElementById('cookie-banner');
    if (!banner) return;

    if (!localStorage.getItem(CONSENT_KEY)) {
      banner.classList.add('visible');
    }

    document.getElementById('cookie-accept')?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'accepted');
      banner.classList.remove('visible');
    });

    document.getElementById('cookie-reject')?.addEventListener('click', () => {
      localStorage.setItem(CONSENT_KEY, 'rejected');
      banner.classList.remove('visible');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
