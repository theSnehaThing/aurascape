---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Aura & Scape - Events, Decor, Experiences"
  description="Aura & Scape — Where creativity meets elegance. Events, Decor, Experiences by Antima & Shilpa. Edinburgh, Scotland."
>
  <!-- Hero -->
  <section class="hero" aria-label="Hero">
    <img src="/assets/hero/hero-bg.jpg" alt="" class="hero-bg" loading="eager" width="1920" height="1080" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>Where Memories Become Magic</h1>
      <p class="hero-subtitle">DREAM &bull; DECORATE &bull; CELEBRATE</p>
      <a href="/contact" class="btn-primary">Book a Consultation</a>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="section section--cream" aria-label="Services">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Our Services</h2>
        <span class="section-line"></span>
      </div>

      <div class="services-grid reveal-stagger">
        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 48V22C10 12 18 6 28 6s18 6 18 16v26"/>
              <path d="M17 48V24c0-6 3-10 11-10s11 4 11 10v24"/>
              <line x1="8" y1="48" x2="48" y2="48"/>
            </svg>
          </div>
          <h3>Events</h3>
          <p>From intimate gatherings to grand celebrations, we craft unforgettable moments with elegance and precision.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="10" y="8" width="36" height="40" rx="1"/>
              <path d="M10 8h36"/>
              <path d="M20 8v40"/>
              <path d="M36 8v40"/>
              <path d="M20 28c3-3 5-4 8-4s5 1 8 4"/>
            </svg>
          </div>
          <h3>Decor</h3>
          <p>Dreamy backdrops, statement florals, and curated styling that brings your vision to life in every detail.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <svg width="56" height="56" viewBox="0 0 56 56" fill="none" stroke="#D4AF37" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 10v4"/>
              <path d="M14 14c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="14" y1="30" x2="14" y2="46"/>
              <path d="M28 8v4"/>
              <path d="M28 12c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="28" y1="28" x2="28" y2="46"/>
              <path d="M42 10v4"/>
              <path d="M42 14c-3 0-5 2-5 6v4c0 4 2 6 5 6s5-2 5-6v-4c0-4-2-6-5-6z"/>
              <line x1="42" y1="30" x2="42" y2="46"/>
            </svg>
          </div>
          <h3>Experiences</h3>
          <p>Curated sensory experiences and interactive moments that transform your event into a story worth telling.</p>
        </div>
      </div>

      <div class="text-center" style="margin-top: 40px;">
        <a href="/services" class="btn-outline">View All Services</a>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="section section--rose" aria-label="Founders">
    <div class="container text-center">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>By the Founders</h2>
        <span class="section-line"></span>
      </div>

      <div class="founders-row reveal">
        <div class="founder">
          <img src="/assets/hero/antima.jpg" alt="Antima" class="founder-photo" width="240" height="240" loading="lazy" />
          <h3>Antima</h3>
          <p class="text-muted">Co-Founder</p>
        </div>
        <div class="founder">
          <img src="/assets/hero/shilpa.jpg" alt="Shilpa" class="founder-photo" width="240" height="240" loading="lazy" />
          <h3>Shilpa</h3>
          <p class="text-muted">Co-Founder</p>
        </div>
      </div>

      <blockquote class="founder-quote">
        "Where creativity meets elegance, and every celebration becomes an unforgettable experience."
      </blockquote>

      <a href="/about" class="btn-outline">Read Our Story</a>
    </div>
  </section>

  <!-- Portfolio Strip -->
  <section class="section section--cream" aria-label="Portfolio">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Portfolio</h2>
        <span class="section-line"></span>
      </div>

      <div class="gallery-grid reveal-stagger">
        <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements" loading="lazy" width="400" height="400" />
      </div>

      <div class="text-center" style="margin-top: 40px;">
        <a href="/portfolio" class="btn-outline">View Full Gallery</a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 80px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(251, 248, 243, 0.4) 0%, rgba(28, 59, 50, 0.6) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 48rem;
  }

  .hero-content h1 {
    color: var(--white);
    font-size: 52px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .hero-content h1 { font-size: 36px; }
  }

  .hero-subtitle {
    font-size: 14px;
    letter-spacing: 4px;
    color: var(--accent-gold);
    margin-bottom: 32px;
    text-transform: uppercase;
  }

  /* Services grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  @media (max-width: 768px) {
    .services-grid { grid-template-columns: 1fr; }
  }

  .service-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }

  /* Founders */
  .founders-row {
    display: flex;
    justify-content: center;
    gap: 64px;
    margin-bottom: 40px;
  }

  @media (max-width: 768px) {
    .founders-row { flex-direction: column; align-items: center; gap: 32px; }
  }

  .founder {
    text-align: center;
  }

  .founder-photo {
    width: 240px;
    height: 300px;
    border-radius: 120px 120px 0 0;
    object-fit: cover;
    border: 3px solid var(--accent-gold);
    margin-bottom: 16px;
  }

  @media (max-width: 768px) {
    .founder-photo { width: 180px; height: 220px; border-radius: 90px 90px 0 0; }
  }

  .founder h3 {
    font-size: 24px;
    margin-bottom: 4px;
  }

  .founder-quote {
    background: var(--bg-secondary);
    padding: 32px 48px;
    border-left: 4px solid var(--accent-gold);
    border-radius: 0 12px 12px 0;
    max-width: 600px;
    margin: 0 auto 40px;
    font-style: italic;
    font-size: 20px;
    color: var(--text-main);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .founder-quote { padding: 24px 24px; font-size: 17px; }
  }

  /* Gallery grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    border-radius: 120px 120px 0 0;
  }

  @media (max-width: 768px) {
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
