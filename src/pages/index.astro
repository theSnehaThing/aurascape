---
import MainLayout from '../layouts/MainLayout.astro';
import Ornament from '../components/Ornament.astro';
---

<MainLayout
  title="Aura & Scape — Luxury Event Planning & Decoration | Where Memories Become Magic"
  description="Aura & Scape is a luxury event planning and decoration company by Antima & Shilpa. We bring your vision to life with stunning decor, beautiful events, and unique experiences."
>
  <!-- Hero -->
  <section class="hero section--decorated" aria-label="Hero">
    <Ornament />
    <Ornament position="bottom-right" />
    <img src="/assets/hero/hero-bg.jpg" alt="" class="hero-bg" loading="eager" width="1920" height="1080" />
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1 class="hero-title">
        Aura <span class="amp">&</span> Scape
      </h1>

      <p class="hero-tagline">Events &nbsp;✦&nbsp; Decor &nbsp;✦&nbsp; Experiences</p>

      <p class="hero-byline">By Antima & Shilpa</p>

      <div class="hero-divider">
        <span class="hero-divider-line"></span>
        <span class="hero-divider-diamond">✦</span>
        <span class="hero-divider-line"></span>
      </div>

      <p class="hero-desc">
        From dreamy backdrops to statement décor, we bring your vision to life,
        one magical moment at a time. Where creativity meets elegance, and every
        celebration becomes an unforgettable experience.
      </p>

      <p class="hero-motto">Where Memories Become Magic</p>

      <!-- 5 Feature icons — consistent SVG line style -->
      <div class="hero-features" role="list" aria-label="Our specialities">
        <div class="hero-feature" role="listitem">
          <div class="hero-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3c-1.5 2-4 3.5-4 6.5 0 2 1.5 3.5 4 3.5s4-1.5 4-3.5c0-3-2.5-4.5-4-6.5z"/>
              <path d="M12 13v5"/>
              <path d="M9 21h6"/>
              <path d="M9 18h6"/>
            </svg>
          </div>
          <span class="hero-feature-label">Stunning Decor</span>
        </div>

        <div class="hero-feature" role="listitem">
          <div class="hero-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9"/>
              <circle cx="12" cy="12" r="4"/>
              <line x1="12" y1="3" x2="12" y2="5"/>
              <line x1="12" y1="19" x2="12" y2="21"/>
              <line x1="3" y1="12" x2="5" y2="12"/>
              <line x1="19" y1="12" x2="21" y2="12"/>
            </svg>
          </div>
          <span class="hero-feature-label">Beautiful Events</span>
        </div>

        <div class="hero-feature" role="listitem">
          <div class="hero-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4-6.2-4.6-6.2 4.6 2.4-7.4L2 9.4h7.6z"/>
            </svg>
          </div>
          <span class="hero-feature-label">Unique Experiences</span>
        </div>

        <div class="hero-feature" role="listitem">
          <div class="hero-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21.2l7.8-7.8 1-1a5.5 5.5 0 0 0 0-7.8z"/>
            </svg>
          </div>
          <span class="hero-feature-label">Personalised Touch</span>
        </div>

        <div class="hero-feature" role="listitem">
          <div class="hero-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v3m0 12v3m9-9h-3M6 12H3m14.5-6.5L15 8m-6 8l-2.5 2.5m11 0L15 16M8 8L5.5 5.5"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <span class="hero-feature-label">Magical Memories</span>
        </div>
      </div>

      <!-- CTA -->
      <a href="/contact" class="hero-cta">
        Let's make your next celebration extraordinary
      </a>
    </div>
  </section>

  <!-- Gallery Strip -->
  <section class="section section--ivory" aria-label="Featured work">
    <div class="container">
      <div class="text-center reveal">
        <h2>A Glimpse of Our Work</h2>
        <div class="divider"></div>
      </div>

      <div class="gallery-strip reveal-stagger">
        <img src="/assets/gallery/preview-1.jpg" alt="Elegant floral wedding decoration" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-2.jpg" alt="Luxurious event backdrop with golden arches" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-3.jpg" alt="Romantic candlelit dinner setup" loading="lazy" width="400" height="400" />
        <img src="/assets/gallery/preview-4.jpg" alt="Pastel flower arrangements for celebration" loading="lazy" width="400" height="400" />
      </div>

      <div class="text-center">
        <a href="/gallery" class="link-gold">View Full Gallery →</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section section--cream section--decorated" aria-label="What clients say">
    <Ornament />
    <Ornament position="bottom-right" />
    <div class="container">
      <div class="text-center reveal">
        <h2>Kind Words</h2>
        <div class="divider"></div>
      </div>

      <div class="testimonials-grid reveal-stagger">
        <div class="testimonial">
          <blockquote>"The mandap looked like something from a dream. Every single detail was perfect."</blockquote>
          <footer>— Priya & Ramesh, Wedding</footer>
        </div>
        <div class="testimonial">
          <blockquote>"Our office anniversary felt like a proper celebration for the first time. Flawless execution."</blockquote>
          <footer>— Meera, Corporate Events</footer>
        </div>
        <div class="testimonial">
          <blockquote>"They took my vague idea and turned it into something I didn't even know was possible."</blockquote>
          <footer>— Ananya, Birthday Surprise</footer>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--blush" aria-label="Call to action">
    <div class="container text-center reveal">
      <h2>Ready to Create Something Beautiful?</h2>
      <p class="section-intro">Tell us about your vision. We'll make it real.</p>
      <a href="/contact" class="btn">Start Planning</a>
    </div>
  </section>
</MainLayout>

<style>
  .hero {
    min-height: 100vh;
    padding-top: 5rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1.5rem;
    max-width: 52rem;
  }

  .hero-title {
    font-size: clamp(3rem, 10vw, 5.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .hero-tagline {
    font-size: clamp(0.7rem, 2vw, 0.9rem);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.78);
    margin-bottom: 1rem;
  }

  .hero-byline {
    font-family: var(--font-script);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .hero-divider {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    width: 180px;
    justify-content: center;
  }

  .hero-divider-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold));
  }

  .hero-divider-line:last-child {
    background: linear-gradient(to left, transparent, var(--gold));
  }

  .hero-divider-diamond {
    color: var(--gold);
    font-size: 0.6rem;
  }

  .hero-desc {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: rgba(17, 17, 17, 0.82);
    max-width: 26rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .hero-motto {
    font-family: var(--font-script);
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--teal-deep);
    margin-bottom: 2rem;
  }

  /* Feature icons — consistent SVG line style */
  .hero-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2rem;
    margin-bottom: 2.5rem;
    padding: 0 1rem;
  }

  .hero-feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-feature-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid rgba(201, 169, 110, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    background: rgba(245, 237, 216, 0.5);
    transition: border-color 0.2s, transform 0.2s;
  }

  .hero-feature:hover .hero-feature-icon {
    border-color: var(--gold);
    transform: scale(1.05);
  }

  .hero-feature-label {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(17, 17, 17, 0.8);
    font-weight: 500;
    text-align: center;
  }

  /* CTA */
  .hero-cta {
    display: block;
    width: 100%;
    max-width: 380px;
    padding: 1rem 2rem;
    background-color: #0d2927;
    color: #fff;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    border-radius: 2px;
    transition: background-color 0.2s, transform 0.2s;
  }

  .hero-cta:hover {
    background-color: #1B4D4A;
    transform: translateY(-2px);
  }
</style>
