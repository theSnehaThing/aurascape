---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Services | Event Planning, Decor & Experiences — Aura & Scape, Edinburgh"
  description="Events, decor, guest experiences, personalised touches and full packages — the complete service menu of Aura & Scape, Edinburgh's luxury event design studio."
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container text-center">
      <h1>Our Services</h1>
      <div class="divider"></div>
      <p class="text-muted" style="max-width: 500px; margin: 16px auto 0;">Every service is crafted with the same care — attention to detail, a love of colour, and a genuine desire to see your face when you walk into the space we've created.</p>
    </div>
  </section>

  <!-- Signature services -->
  <section class="section section--cream">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>What We Do</h2>
        <span class="section-line"></span>
      </div>
      <div class="services-full-grid reveal-stagger">
        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_events.svg?v=2" alt="" width="64" height="61" aria-hidden="true" />
          </div>
          <h3>Events</h3>
          <p>Full planning and coordination. From venue selection to the final walk-through, we handle every detail so you can simply be present in your celebration.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_decor.svg?v=2" alt="" width="64" height="61" aria-hidden="true" />
          </div>
          <h3>Decor</h3>
          <p>Florals, draping, lighting and tablescapes. Statement backdrops and floral installations designed to feel like a story worth stepping into.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_experiences.svg?v=2" alt="" width="64" height="61" aria-hidden="true" />
          </div>
          <h3>Experiences</h3>
          <p>Curated sensory moments — live music, fragrance stations, interactive displays, and surprise elements that make guests feel truly special.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Signature touches -->
  <section class="section section--rose">
    <div class="container">
      <div class="section-heading">
        <span class="section-line"></span>
        <h2>Signature Touches</h2>
        <span class="section-line"></span>
      </div>
      <p class="text-muted group-intro">Layer onto any service — the details that make your event unmistakably yours.</p>
      <div class="services-full-grid reveal-stagger">
        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_personalised_touch.svg?v=2" alt="" width="64" height="61" aria-hidden="true" />
          </div>
          <h3>Personalised Touch</h3>
          <p>Custom stationery, keepsakes, monogrammed details, and bespoke elements carried from the first envelope to the last favour.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_magical_memories.svg?v=2" alt="" width="64" height="61" aria-hidden="true" />
          </div>
          <h3>Magical Memories</h3>
          <p>Photo booths, guest books, and video installations that preserve your celebration for years to come.</p>
        </div>

        <div class="service-card">
          <div class="service-icon">
            <img src="/assets/brand/icon_full_package.svg?v=2" alt="" width="64" height="61" loading="lazy" aria-hidden="true" />
          </div>
          <h3>Full Package</h3>
          <p>End-to-end design and execution, from first concept to final clean-up. One point of contact, zero stress, maximum magic.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--cream cta-section">
    <div class="container text-center">
      <h2>Let's Create Together</h2>
      <p class="text-muted" style="max-width: 480px; margin: 16px auto 32px;">Every great event starts with a conversation. Tell us what you're dreaming of.</p>
      <a href="/contact" class="btn-primary">Tell Us What You're Planning</a>
    </div>
  </section>
</MainLayout>

<style>
  .page-hero {
    padding: 120px 48px 60px;
    background: var(--bg-primary);
  }

  @media (max-width: 768px) {
    .page-hero { padding: 100px 20px 40px; }
  }

  .services-full-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .group-intro {
    max-width: 480px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .section-heading { margin-bottom: 48px; }

  .cta-section { border-top: 1px solid var(--border-light); }

  @media (max-width: 768px) {
    .services-full-grid { grid-template-columns: 1fr; }
  }

  .service-icon {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }
</style>
